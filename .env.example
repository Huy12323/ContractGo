# =============================================================================
# WorldCraft Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Supabase (Local) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=             # From `supabase status` after `supabase start`
SUPABASE_SERVICE_ROLE_KEY=     # From `supabase status` (backend only, never expose to frontend)

# --- Supabase (Cloud — fill when deploying) ---
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=       # From `supabase status`
VITE_API_URL=http://localhost:3000

# --- Backend (NestJS) ---
API_PORT=3000
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Plane (PM workflow — optional) ---
PLANE_API_KEY=
PLANE_BASE_URL=

# --- Outline (PM workflow — optional) ---
OUTLINE_API_KEY=
OUTLINE_BASE_URL=
