# ============================================
# ContractGo — Centralized Environment Variables
# ============================================
# Copy to .env.dev (development), .env.stag (staging), or .env.prod (production)
# Then run: pnpm env:apply:dev (or env:apply:stag / env:apply:prod)
#
# Format:
# - SHARED section: Variables defined once and referenced with ${VAR_NAME}
# - [SECTION] headers: Variables distributed to specific destinations

# ============================================
# SHARED VARIABLES (define once, reference below with ${VAR_NAME})
# ============================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=re_fqA4cqYg_Fmdu4y48EXyNcrMoYr13KsPi
RESEND_SENDER_EMAIL=onboarding@resend.dev                # e.g., noreply@e.aiursoftware.com (must be verified on Resend)
RESEND_SENDER_NAME=ContractGo
# Shared HS256 secret: edge fn files_r2_sign-read-url mints; Worker verifies.
# Min 32 chars. Rotate by `wrangler secret put WORKER_JWT_SECRET --env <env>`
# AND Supabase Dashboard → Edge Functions → Secrets in lockstep.
WORKER_JWT_SECRET=
# Supabase's own JWT secret — the one used to sign user access tokens. Verifiers
# (CF Worker files-serving, backend/thumbnailer direct-call endpoint) decode user
# tokens against this. Local value comes from `supabase status` → "JWT secret".
SUPABASE_JWT_SECRET=

# --- Remote deploy (staging/prod only — leave blank for dev) ---
# Supavisor session-mode pooler URL used by `supabase db push`.
# Format: postgresql://postgres.<tenant>:<password>@<host>:<port>/postgres
SUPABASE_DB_URL=
# SSH destination for edge function upload (tar-over-ssh; CLI doesn't support self-hosted functions deploy).
# Accepts an SSH config alias or a raw destination, e.g. "root@5.78.184.149".
DEPLOY_SSH_TARGET=
# Optional ssh flags, e.g. "-i ~/.ssh/aiurhr_deploy -p 22".
DEPLOY_SSH_OPTS=
# Absolute path on the server to the Supabase functions volume.
DEPLOY_REMOTE_FUNCTIONS_PATH=

# ============================================
# [VITE] -> frontend/vite/.env
# ============================================
# Vite frontend requires VITE_ prefix for browser access
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_PUBLISHABLE_KEY}
VITE_R2_WORKER_URL=                 # dev: http://localhost:8787 | staging/prod: Worker custom-domain URL

# ============================================
# [SUPABASE_CONFIG] -> frontend/vite/supabase/.env
# ============================================
# Used by config.toml env() function for SMTP, etc.
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_SENDER_EMAIL=${RESEND_SENDER_EMAIL}
RESEND_SENDER_NAME=${RESEND_SENDER_NAME}
# Google sign-in (CG-028). Web-application OAuth client from Google Cloud Console
# → Credentials. Its authorized redirect URIs must list GoTrue's callback for
# every environment that uses this client:
#   http://localhost:54321/auth/v1/callback              (local CLI stack)
#   https://aiurhr-sb.aiursoftware.com/auth/v1/callback  (production Kong)
# Local only — production GoTrue reads GOTRUE_EXTERNAL_GOOGLE_* from the server
# env, not from config.toml. See docs/deployment.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# [SUPABASE_FUNCTIONS] -> frontend/vite/supabase/functions/.env
# ============================================
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SECRET_KEY}
# Object-storage backend for files_r2_* edge functions:
#   r2    = Cloudflare R2 + files-serving Worker (production path; needs the R2_* vars below)
#   local = Supabase Storage bucket (temporary stand-in while no Cloudflare account exists;
#           needs no R2 credentials and no `pnpm dev:w` Worker)
STORAGE_DRIVER=r2
# local driver only — bucket name and the browser-reachable Supabase origin used to
# rewrite signed URLs (inside the edge runtime SUPABASE_URL is the internal kong host).
STORAGE_LOCAL_BUCKET=files
STORAGE_LOCAL_PUBLIC_URL=${SUPABASE_URL}
# Mail delivery backend for shared--send-email:
#   resend  = Resend API (production path; needs the RESEND_* vars below)
#   console = render the message and log it instead of sending. DEV ONLY — the
#             log line contains the signing link verbatim, which is a live
#             credential. Without this, a fresh local stack cannot reach the
#             signer surface at all, since the emailed link is the only way in.
EMAIL_DRIVER=resend
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_SENDER_EMAIL=${RESEND_SENDER_EMAIL}
RESEND_SENDER_NAME=${RESEND_SENDER_NAME}
APP_URL=http://localhost:5173
# Origin the EXTERNAL SIGNER's emailed link points at — `{SIGNER_PORTAL_URL}/sign/{token}`.
# Defaults to APP_URL when unset, which is correct everywhere the signer portal is the
# same origin as the app. Split it only if the portal ever moves to its own host.
SIGNER_PORTAL_URL=
# How long an emailed signing link stays valid, in hours. Default 336 (14 days).
# Shorter is safer (links get forwarded); too short means routine resends.
SIGNER_TOKEN_TTL_HOURS=336
# Shared secret for the two SCHEDULED edge functions (envelopes_cron_expire,
# envelopes_cron_remind). They deploy with verify_jwt = false — pg_cron reaches
# them through net.http_post, which carries no JWT — so this header IS the
# authorization, exactly as the signer's token is for the public signing surface.
# Min 32 random chars. Read via `requireEnv`, never `Deno.env.get(x)!`: a
# silently-absent secret would make the check `undefined === undefined`.
#
# ⚠ IT MUST ALSO BE WRITTEN INTO THE DATABASE, or the jobs fire at nothing.
# Postgres is the SENDER of that header and cannot read this file. After
# `pnpm sb:dev:push`, run once per environment (as service_role / psql):
#
#   UPDATE public.cron_dispatch_config
#      SET functions_base_url = '<SUPABASE_URL>',
#          cron_secret        = '<CRON_SHARED_SECRET>',
#          updated_at         = now()
#    WHERE id = 'singleton';
#
# Until then `cron_dispatch()` no-ops with a NOTICE rather than posting nowhere,
# so an unconfigured stack schedules the jobs harmlessly. See migration CG-013.
CRON_SHARED_SECRET=
# Signing provider seam (_shared/signing.ts). Four INDEPENDENT drivers, because
# in practice the certificate authority, the eKYC vendor and the timestamp
# authority are three different companies — and during development you want mock
# signing with a real OTP. All default to `mock` when unset.
#   SIGNING_DRIVER    mock | ceca_remote | hsm_local
#   IDENTITY_DRIVER   mock | ekyc_vendor      (v1.2.0)
#   OTP_DRIVER        mock | email | sms_vendor  (v1.2.0)
#   TIMESTAMP_DRIVER  mock | rfc3161
# `mock` produces a structurally valid PAdES-B_B over a SELF-SIGNED certificate:
# Adobe opens it and reports "signer's identity unknown", which is correct. It is
# evidentially worthless and the UI says so — never ship it as a real signature.
SIGNING_DRIVER=mock
IDENTITY_DRIVER=mock
OTP_DRIVER=mock
TIMESTAMP_DRIVER=mock
# Cloudflare R2 credentials for files_r2_upload-start presigned PUT.
# Create under Cloudflare dashboard → R2 → Manage R2 API Tokens → Create token
# (scope: Object Read & Write, restrict to bucket aiurhr--{env}).
R2_ACCOUNT_ID=                      # 156c6587f5eeeef516ea33aba5b50fb2 (Jimbui Cloudflare account)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=                     # dev: aiurhr--dev | stag: aiurhr--stag | prod: aiurhr--prod
WORKER_JWT_SECRET=${WORKER_JWT_SECRET}
# URL where the Cloudflare Worker serves files — edge fn files_r2_sign-read-url
# embeds this as the origin in signed URLs. Match VITE_R2_WORKER_URL above.
R2_WORKER_URL=
# Tells edge fn which deployment (dev|staging|production) it's running in so
# read tokens carry the correct `env` claim (Worker rejects cross-env tokens).
ENVIRONMENT=development

# ============================================
# [WORKER_FILE_STORAGE] -> cloudflare/workers/files/.dev.vars
# ============================================
SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SECRET_KEY}
ALLOWED_ORIGINS=                    # dev: http://localhost:5173 | staging/prod: comma-separated origins
WORKER_JWT_SECRET=${WORKER_JWT_SECRET}

# ============================================
# [MCP] -> .env (root-level tools: PM scripts, wrangler-auto-restart)
# ============================================
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=aiur
PLANE_BASE_URL=https://plane.jimbui.dev
OUTLINE_API_KEY=
OUTLINE_API_URL=https://outline.jimbui.dev/api
DEFAULT_INTAKE_ASSIGNEE_UUID=
DEFAULT_ITEM_ASSIGNEE_UUID=
# Wrangler auth for the Cloudflare account referenced in cloudflare/workers/files/wrangler.toml.
# Required for remote = true R2 bindings during `pnpm dev`. Create at:
#   Cloudflare dashboard → Profile → API Tokens → Create
# Needs: Workers Scripts:Edit, Workers R2 Storage:Edit, Workers Tail:Read
CLOUDFLARE_API_TOKEN=
