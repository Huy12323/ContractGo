# =============================================================================
# WorldCraft Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Supabase (Local) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=      # From `supabase status` after `supabase start`
SUPABASE_SECRET_KEY=           # From `supabase status`

# --- Supabase (Staging) ---
# SUPABASE_URL=https://srwkvuvdkcquxxblaxdp.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# --- Supabase (Production) ---
# SUPABASE_URL=https://xzhgrfuuuwlntadzcqne.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=       # Publishable key (sb_publishable_... or local anon key)

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=                 # Cloudflare account ID
R2_ACCESS_KEY_ID=              # R2 API token access key
R2_SECRET_ACCESS_KEY=          # R2 API token secret key
R2_BUCKET_NAME=                # e.g. worldcraft-staging or worldcraft-production
R2_PUBLIC_URL=                 # e.g. https://files.yourdomain.com (if using custom domain)

# --- Plane (PM workflow — optional) ---
PLANE_API_KEY=
PLANE_BASE_URL=

# --- Outline (PM workflow — optional) ---
OUTLINE_API_KEY=
OUTLINE_BASE_URL=
