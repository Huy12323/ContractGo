# ============================================
# AIUR HR — Centralized Environment Variables
# ============================================
# Copy to .env.dev (development), .env.stag (staging), or .env.prod (production)
# Then run: pnpm env:apply dev (or stag/prod)
#
# Format:
# - SHARED section: Variables defined once and referenced with ${VAR_NAME}
# - [SECTION] headers: Variables distributed to specific destinations

# ============================================
# SHARED VARIABLES (define once, reference below with ${VAR_NAME})
# ============================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=                # e.g., noreply@e.aiursoftware.com (must be verified on Resend)
RESEND_SENDER_NAME=AIUR HR

# ============================================
# [VITE] -> apps/web/.env
# ============================================
# Vite frontend requires VITE_ prefix for browser access
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_PUBLISHABLE_KEY}

# ============================================
# [SUPABASE_CONFIG] -> supabase/.env
# ============================================
# Used by config.toml env() function for SMTP, etc.
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_SENDER_EMAIL=${RESEND_SENDER_EMAIL}
RESEND_SENDER_NAME=${RESEND_SENDER_NAME}

# ============================================
# [SUPABASE_FUNCTIONS] -> supabase/functions/.env
# ============================================
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SECRET_KEY}
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_SENDER_EMAIL=${RESEND_SENDER_EMAIL}
RESEND_SENDER_NAME=${RESEND_SENDER_NAME}
APP_URL=http://localhost:5173

# ============================================
# [MCP] -> .env (PM scripts: Plane, Outline)
# ============================================
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=aiur
PLANE_BASE_URL=https://plane.jimbui.dev
OUTLINE_API_KEY=
OUTLINE_API_URL=https://outline.jimbui.dev/api
DEFAULT_INTAKE_ASSIGNEE_UUID=
DEFAULT_ITEM_ASSIGNEE_UUID=
