# ============================================
# AIUR HR — Centralized Environment Variables
# ============================================
# Copy to .env.dev (development), .env.stag (staging), or .env.prod (production)
# Then run: pnpm env:apply:dev (or env:apply:stag / env:apply:prod)
#
# Format:
# - SHARED section: Variables defined once and referenced with ${VAR_NAME}
# - [SECTION] headers: Variables distributed to specific destinations

# ============================================
# SHARED VARIABLES (define once, reference below with ${VAR_NAME})
# ============================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=                # e.g., noreply@e.aiursoftware.com (must be verified on Resend)
RESEND_SENDER_NAME=AIUR HR

# ============================================
# [VITE] -> frontend/vite/.env
# ============================================
# Vite frontend requires VITE_ prefix for browser access
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_PUBLISHABLE_KEY}
VITE_R2_WORKER_URL=                 # dev: http://localhost:8787 | staging/prod: Worker custom-domain URL

# ============================================
# [SUPABASE_CONFIG] -> frontend/vite/supabase/.env
# ============================================
# Used by config.toml env() function for SMTP, etc.
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_SENDER_EMAIL=${RESEND_SENDER_EMAIL}
RESEND_SENDER_NAME=${RESEND_SENDER_NAME}

# ============================================
# [SUPABASE_FUNCTIONS] -> frontend/vite/supabase/functions/.env
# ============================================
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SECRET_KEY}
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_SENDER_EMAIL=${RESEND_SENDER_EMAIL}
RESEND_SENDER_NAME=${RESEND_SENDER_NAME}
APP_URL=http://localhost:5173

# ============================================
# [WORKER_FILE_STORAGE] -> cloudflare/workers/files/.dev.vars
# ============================================
SUPABASE_JWT_SECRET=                # dev: Supabase local JWT secret (supabase status → "JWT secret")
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SECRET_KEY}
ALLOWED_ORIGINS=                    # dev: http://localhost:5173 | staging/prod: comma-separated origins

# ============================================
# [MCP] -> .env (root-level tools: PM scripts, wrangler-auto-restart)
# ============================================
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=aiur
PLANE_BASE_URL=https://plane.jimbui.dev
OUTLINE_API_KEY=
OUTLINE_API_URL=https://outline.jimbui.dev/api
DEFAULT_INTAKE_ASSIGNEE_UUID=
DEFAULT_ITEM_ASSIGNEE_UUID=
# Wrangler auth for the Cloudflare account referenced in cloudflare/workers/files/wrangler.toml.
# Required for remote = true R2 bindings during `pnpm dev`. Create at:
#   Cloudflare dashboard → Profile → API Tokens → Create
# Needs: Workers Scripts:Edit, Workers R2 Storage:Edit, Workers Tail:Read
CLOUDFLARE_API_TOKEN=
