<?xml version="1.0" encoding="UTF-8"?>
<!--
    The three URLs a stranger can open without an account. Everything else in
    this product needs a session or a token, and is disallowed in robots.txt.

    No `lastmod`: a hand-maintained date is wrong within a week of being written,
    and a stale one is a worse signal than none. Add it when the build generates
    this file rather than when a person edits it.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://hr.aiursoftware.com/</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>https://hr.aiursoftware.com/try</loc>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>https://hr.aiursoftware.com/verify</loc>
        <changefreq>monthly</changefreq>
        <priority>0.5</priority>
    </url>
</urlset>
