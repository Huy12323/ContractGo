{
    "rules": [
        {
            "allowed": {
                "origins": [
                    "http://localhost:5173",
                    "http://127.0.0.1:5173"
                ],
                "methods": ["PUT", "GET", "HEAD"],
                "headers": ["*"]
            },
            "exposeHeaders": ["ETag"],
            "maxAgeSeconds": 3600
        }
    ]
}
