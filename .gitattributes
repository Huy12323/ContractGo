# Normalize all text files to LF in the repository.
# Without this, Windows checkouts commit CRLF and every diff is polluted.
* text=auto eol=lf

# Explicit text types
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.sh    text eol=lf

# Windows-only scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary — never diff, never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.gz    binary

# Generated / vendored — collapse in review, exclude from language stats
pnpm-lock.yaml                              linguist-generated=true -diff
frontend/vite/src/routeTree.gen.ts          linguist-generated=true -diff
frontend/vite/src/types/database.types.ts   linguist-generated=true -diff
